# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，绝不入库）

# DashScope / Qwen-VL API key（必填：bm_run.py 与 QwenVLClient 使用）
QWEN_API_KEY=sk-your-dashscope-key

# 以下为可选的第三方模型配置（按需填）
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama 本地模型（可选）
OLLAMA_API_URL=
OLLAMA_CHAT_API_URL=
OLLAMA_MODEL=

# habitat_sim 日志降噪（可选）
MAGNUM_LOG=quiet
GLOG_minloglevel=2
HABITAT_SIM_LOG=quiet
HABITAT_LOG_LEVEL=ERROR
